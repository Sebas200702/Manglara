GEMINI_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_VOICE_NAME=Zephyr
PORT=8000
# Orígenes extra del frontend con permiso CORS (coma-separados), p. ej. la web desplegada.
CORS_ALLOW_ORIGINS=

# Voz pública (/ws/voice): cada sesión gasta cuota de Gemini Live.
# 0 / vacío = sin límite. El tope por IP afecta a quienes comparten wifi.
VOICE_MAX_SESSIONS=0
VOICE_MAX_SESSIONS_PER_IP=0
# Orígenes del navegador que pueden abrir la voz (coma-separados). Vacío = todos.
VOICE_ALLOWED_ORIGINS=
# Sesiones nuevas por minuto (cada una cuesta ~18k tokens al conectar). 0 = sin límite.
VOICE_MAX_NEW_SESSIONS_PER_MIN=0
# Cierra la sesión tras este silencio (s) y a los N minutos. 0 = nunca.
VOICE_IDLE_TIMEOUT_S=90
VOICE_MAX_SESSION_MIN=0
# Conocimiento precargado por sesión (caracteres); el RAG cubre el resto.
VOICE_PRELOAD_CHARS=60000
# Resolución de los frames de cámara para Gemini (vacío = la del modelo).
GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_LOW
# false = no registrar transcripciones de la voz pública en los logs.
LOG_TRANSCRIPTS=true
# false = apaga la API del bot de reuniones (/meetings, sin autenticación).
MEETINGS_ENABLED=true

# Supabase (PostgreSQL + pgvector + Storage)
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=<service_role_key>
SUPABASE_STORAGE_BUCKET=documents

# Live Meeting con Manglara (bot de reuniones externas)
MEETING_BOT_NAME=Manglara
MEETING_HEADLESS=true
MEETING_CHROME_PROFILE_DIR=
MEETING_MAX_DURATION_MIN=180
# Sale sola si es la única participante este tiempo (0 = nunca).
MEETING_ALONE_TIMEOUT_MIN=10
MEETING_AVATAR_URL=/meeting/avatar
# Origen de la web app: el bot carga ahí la página del avatar (su cámara).
MEETING_WEB_URL=http://localhost:5173
# Silencio (ms) que cierra el turno de un participante. Más bajo = responde
# antes pero puede cortar a quien hace pausas. 0 = VAD por defecto de Gemini.
MEETING_VAD_SILENCE_MS=500

# Panel de conocimiento (gestor único)
# ADMIN_PASSWORD_HASH lo genera `python scripts/hash_password.py`.
# Un ADMIN_PASSWORD en claro también funciona, aunque no es lo recomendado.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Orígenes que pueden llamar en cross-origin a la API con cookie
KNOWLEDGE_ALLOWED_ORIGINS=
