GEMINI_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_VOICE_NAME=Zephyr
PORT=8000
# Orígenes extra del frontend con permiso CORS (coma-separados), p. ej. la web desplegada.
CORS_ALLOW_ORIGINS=

# Supabase (PostgreSQL + pgvector + Storage)
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=<service_role_key>
SUPABASE_STORAGE_BUCKET=documents

# Live Meeting con Manglara (bot de reuniones externas)
MEETING_BOT_NAME=Manglara
MEETING_HEADLESS=true
MEETING_CHROME_PROFILE_DIR=
MEETING_MAX_DURATION_MIN=180
# Sale sola si es la única participante este tiempo (0 = nunca).
MEETING_ALONE_TIMEOUT_MIN=10
MEETING_AVATAR_URL=/meeting/avatar
# Origen de la web app: el bot carga ahí la página del avatar (su cámara).
MEETING_WEB_URL=http://localhost:5173
