{
  "name": "manglara",
  "private": true,
  "workspaces": [
    "packages/shared",
    "web"
  ],
  "scripts": {
    "dev": "cd web && bun run dev",
    "build": "bun --filter @manglara/shared build && bun --filter web build",
    "start": "bun run --cwd web preview -- --host 0.0.0.0 --port 3000"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
