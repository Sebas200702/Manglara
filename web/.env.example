# Backend origin for the voice WebSocket (frontend -> backend).
# Accepts an http(s):// or ws(s):// origin, or a bare host[:port].
# The ws/wss scheme is derived from the page when no ws scheme is given.
# Leave unset for local dev (defaults to localhost:8000).
#
# NOTE: Vite inlines VITE_* vars at BUILD time, so set this before `vite build`
# (or in the shell / a real `.env` before `bun run dev`).
#
# Examples:
#   VITE_BACKEND_URL=https://api.manglara.example.com
#   VITE_BACKEND_URL=wss://api.manglara.example.com
#   VITE_BACKEND_URL=192.168.1.50:8000
