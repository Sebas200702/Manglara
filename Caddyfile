# Caddyfile del front de Manglara.
#
# Railpack usa este archivo en lugar de su plantilla por defecto (spa.go:
# TemplateFiles busca "Caddyfile" en la raiz del build path). Se sirve el
# build de Vite (web/dist) y se proxea el backend para que el panel de
# conocimiento hable con /api/* de este mismo origen: asi la cookie de
# sesion es first-party y no hace falta CORS con credenciales.
#
# El backend se resuelve con la variable de entorno BACKEND_URL; el valor por
# defecto evita que el contenedor se caiga si la variable no llegara.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Cache. Los bundles de Vite (/assets/*) llevan hash en el nombre: se
	# cachean para siempre. Los medios de public/ (avatar, video, headaudio)
	# no llevan hash: un día. Lo demás (index.html y rutas de la SPA)
	# siempre se revalida, para que un deploy nuevo se vea al recargar.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@media path *.glb *.mp4 *.mp3 *.svg *.png /headaudio/* /logos/*
	header @media Cache-Control "public, max-age=86400"

	@revalidate not path /assets/* *.glb *.mp4 *.mp3 *.svg *.png /headaudio/* /logos/* /api/* /ws/*
	header @revalidate Cache-Control "no-cache"

	# API REST del backend (panel de conocimiento, ingesta de fuentes).
	handle /api/* {
		reverse_proxy {$BACKEND_URL:https://api.manglara.app}
	}

	# WebSocket de voz, por si el front se deja de hablar con el backend
	# absoluto y usa el mismo origen. La ruta real es /ws/voice.
	handle /ws/* {
		reverse_proxy {$BACKEND_URL:https://api.manglara.app}
	}

	handle {
		root * {{.DIST_DIR}}

		# El GLB del avatar no trae un MIME conocido (sale como
		# octet-stream y no se comprime); con este tipo entra en el match de
		# encode y baja de ~3.5 MB a ~1.9 MB.
		@glb path *.glb
		header @glb Content-Type model/gltf-binary

		file_server {
			hide .git
			hide .env*
		}

		# zstd primero: Caddy usa el primer formato cuando el cliente no tiene
		# preferencia. Lista = los tipos del match por defecto de Caddy que este
		# sitio sirve, mas model/gltf-binary.
		encode {
			zstd
			gzip
			match {
				header Content-Type application/javascript*
				header Content-Type application/json*
				header Content-Type application/manifest+json*
				header Content-Type application/wasm*
				header Content-Type application/xml*
				header Content-Type application/xhtml+xml*
				header Content-Type application/x-javascript*
				header Content-Type font/*
				header Content-Type image/svg+xml*
				header Content-Type image/x-icon*
				header Content-Type image/vnd.microsoft.icon*
				header Content-Type model/gltf-binary*
				header Content-Type text/*
			}
		}

		# Fallback de la SPA: /conocimiento, /reunion, /meeting/avatar...
		try_files {path} {path}.html {path}/index.html /index.html
	}
}
