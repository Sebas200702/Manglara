GEMINI_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_VOICE_NAME=Zephyr
PORT=8000

# Supabase (PostgreSQL + pgvector + Storage)
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=<service_role_key>
SUPABASE_STORAGE_BUCKET=documents

# Panel de conocimiento (gestor único)
# ADMIN_PASSWORD_HASH lo genera `python scripts/hash_password.py`.
# Un ADMIN_PASSWORD en claro también funciona, aunque no es lo recomendado.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Orígenes que pueden llamar en cross-origin a la API con cookie
KNOWLEDGE_ALLOWED_ORIGINS=
